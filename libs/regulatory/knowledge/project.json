{
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/regulatory/knowledge",
        "main": "libs/regulatory/knowledge/src/index.ts",
        "tsConfig": "libs/regulatory/knowledge/tsconfig.lib.json",
        "assets": ["libs/regulatory/knowledge/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/regulatory/knowledge/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "libs/regulatory/knowledge/**/*.ts"
        ]
      }
    }
  }
}